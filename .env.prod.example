# Copy to .env on the VPS (docker-compose.prod.yml reads these)
DB_PASSWORD=change-this-to-something-real
DOMAIN=forecast.yourdomain.com.au

# Local file for now. Swap to a Google Sheets published-CSV URL later --
# nothing else needs to change. See README.md.
SOURCE_REF=./data/orders-with-dates.xlsx
MONTHLY_SOURCE_REF=./data/quarter-sales.xls

# Product catalog (category/subcategory master data) -- live-synced from a
# Google Sheet. The sheet MUST be shared as "Anyone with the link" ->
# Viewer, or this URL just returns Google's login page instead of data.
# Build this URL as: .../export?format=csv&gid=<the tab's gid>
CATALOG_SOURCE_REF=https://docs.google.com/spreadsheets/d/1gTu9OhMGHgsyeiT6zgepNHl-9MpT7T6s8aKXMBIRLOw/export?format=csv&gid=577860459
